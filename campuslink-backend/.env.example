# ===================== Profil actif =====================
SPRING_PROFILES_ACTIVE=dev

# ===================== Serveur =====================
SERVER_PORT=8080

# ===================== Base de données =====================
# Défaut local : MySQL via WampServer (aucune variable à renseigner,
# root sans mot de passe sur le port 3306).
# DB_NAME est utilisé par docker-compose.yml pour construire DB_URL et POSTGRES_DB
DB_NAME=campuslink_db

# --- Option WampServer (MySQL) — valeurs par défaut, à laisser commentées ---
# DB_URL=jdbc:mysql://localhost:3306/campuslink_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&nullCatalogMeansCurrent=true
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_USERNAME=root
# DB_PASSWORD=

# --- Option Docker/PostgreSQL (reactivez ces lignes) ---
# DB_URL=jdbc:postgresql://localhost:5432/campuslink_db
# DB_DRIVER=org.postgresql.Driver
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# ===================== Production (Render + Neon) =====================
# SPRING_PROFILES_ACTIVE=prod
# PORT est injecté automatiquement par Render (ne pas définir manuellement)
# DB_URL doit inclure ?sslmode=require, ex :
# DB_URL=jdbc:postgresql://<host>.neon.tech/<db>?sslmode=require
# DB_POOL_MAX=5
# DB_POOL_MIN=1
DDL_AUTO=update
SHOW_SQL=true

# ===================== JWT =====================
# Générer une clé secrète forte (>= 256 bits) pour la production
# Générer avec : openssl rand -base64 48   (ne JAMAIS réutiliser cette valeur d'exemple)
JWT_SECRET=REPLACE_ME_with_a_random_secret_of_at_least_48_characters_xxxxxxxx
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ===================== Spring Mail =====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@example.com
MAIL_PASSWORD=your-app-password

# ===================== OTP =====================
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Toutes les 15 minutes (format cron Spring : seconde minute heure jour mois jour-semaine)
OTP_CLEANUP_CRON=0 */15 * * * *

# ===================== Forgot Password =====================
PASSWORD_RESET_EXPIRATION_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
# URL du frontend qui affichera le formulaire de nouveau mot de passe (le token
# est ajouté automatiquement en paramètre de requête : ?token=...)
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_CLEANUP_CRON=0 */15 * * * *

# ===================== Cloudinary =====================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===================== Média (upload / compression) =====================
MEDIA_FOLDER=campuslink
MEDIA_MAX_FILE_SIZE_BYTES=5242880
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
MEDIA_IMAGE_QUALITY=auto:good
MEDIA_MAX_DIMENSION=1080

# ===================== CORS =====================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173,http://127.0.0.1:5173

# ===================== Logs =====================
LOG_LEVEL=DEBUG
SQL_LOG_LEVEL=INFO
